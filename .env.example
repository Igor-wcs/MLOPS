# =================================================================
# DATATHON - AMBIENTE E SEGREDOS (ARQUIVO COMPLETO)
# =================================================================

# --- 1. Inteligência Artificial (LLMs e Agentes) ---
# Necessário para Agente ReAct, avaliação RAGAS e LLM-as-a-judge
OPENAI_API_KEY=sua_chave_aqui

# --- 2. Orquestração (Airflow) ---
# UID do usuário para permissões de volume no Docker
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Chave para criptografia interna das senhas do Airflow
AIRFLOW_SECRET_KEY=chave_secreta_padrao_datathon

# --- 3. Experiment Tracking (MLflow) ---
# IMPORTANTE: Dentro do Docker, o host deve ser o nome do serviço 'mlflow'[cite: 4]
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- 4. Infraestrutura e Cache (Feature Store) ---
# Configurações para o GAP 03 (Upsert Incremental)[cite: 5]
REDIS_HOST=redis
REDIS_PORT=6379
# Tempo de vida das features (TTL) em dias, conforme seu feature_store.py[cite: 3]
REDIS_TTL_DAYS=90

# --- 5. Monitoramento e Dashboards ---
# Senha para o painel administrativo do Grafana[cite: 4]
GRAFANA_PASSWORD=admin
# Webhook opcional para alertas de Drift (GAP 01 e 06)[cite: 5]
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/seu_token_aqui

# --- 6. Banco de Dados (Postgres) ---
# Deve bater com as variáveis do serviço postgres no docker-compose[cite: 4]
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- 7. Caminhos e Modelos ---
# Nome do modelo para registro no MLflow[cite: 2, 5]
REGISTERED_MODEL_NAME=LSTM_Petrobras