# ==========================================
# DATATHON - AMBIENTE E SEGREDOS
# ==========================================

# --- 1. Inteligência Artificial (LLMs) ---
# Necessário para avaliação RAGAS e LLM-as-a-judge
OPENAI_API_KEY=sua_chave_aqui

# --- 2. Orquestração (Airflow) ---
# UID do usuário no Linux (use 1000 se não souber)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=chave_secreta_padrao_datathon

# --- 3. Experiment Tracking (MLflow) ---
# Porta padrão é 5000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- 4. Infraestrutura e Cache ---
# Senha para o painel administrativo do Grafana
GRAFANA_PASSWORD=admin

# --- 5. Segurança e Alertas ---
# Webhook opcional para alertas de Drift no Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
